				PositionInputs posInput = GetPositionInput( input.positionSS.xy, _ScreenSize.zw, input.positionSS.z, input.positionSS.w, input.positionRWS.xyz, tileIndex );

				GlobalSurfaceDescription surfaceDescription = (GlobalSurfaceDescription)0;
				float2 uv_Albedo = packedInput.ase_texcoord8.xy * _Albedo_ST.xy + _Albedo_ST.zw;
				float4 tex2DNode1 = tex2D( _Albedo, uv_Albedo );
				float3 ase_positionWS = GetAbsolutePositionWS( PositionRWS );
				float simplePerlin2D65 = snoise( (ase_positionWS).xz*_BlotchSize );
				simplePerlin2D65 = simplePerlin2D65*0.5 + 0.5;
