        -> [nomarkup][Go inside.][/nomarkup]
    <<else>>
        {$storyteller}:[nomarkup][Despite your best efforts, the door doesn't budge.][/nomarkup] #failure #line:0082b73 
        <<jump DoorVisit>> 
    <<endif>>
<<endif>>
